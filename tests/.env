# Default/example configuration for the manual SEF test scripts in this folder.
# This file is committed and must not contain real secrets.
#
# To run the scripts against a real (demo) SEF account, copy this file to
# .env.local (gitignored) and fill in the real values there. Anything set in
# .env.local overrides the same key here; anything already set in your shell
# environment overrides both files.

# SEF connection
SEF_API_KEY=
SEF_ROOT_URI=https://demoefaktura.mfin.gov.rs/

# Seller (your company, must be registered on SEF)
SEF_SELLER_PIB=
SEF_SELLER_NAME=
SEF_SELLER_CITY=
SEF_SELLER_IDENTIFICATION=
SEF_SELLER_EMAIL=
SEF_SELLER_BANK_ACCOUNT=

# Buyer (the invoice recipient, must also be registered on SEF).
# Optional: leave blank to send the test invoice to yourself (buyer == seller).
SEF_BUYER_PIB=
SEF_BUYER_NAME=
SEF_BUYER_ADDRESS=
SEF_BUYER_CITY=
SEF_BUYER_IDENTIFICATION=
SEF_BUYER_EMAIL=

# Optional contract number to attach to the test invoice
SEF_CONTRACT_NUMBER=

# Options for the pull test (all optional)
# SEF_PULL_DIRECTION: Outbound (invoices you sent, default) or Inbound (invoices you received)
SEF_PULL_DIRECTION=Outbound
SEF_PULL_STATUS=
SEF_PULL_DATE_FROM=
SEF_PULL_DATE_TO=
SEF_PULL_LIMIT=5
